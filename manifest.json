{
  "id": "./",
  "name": "المعلم للخياطة",
  "short_name": "المعلم للخياطة",
  "start_url": "./index.html?v=5.11",
  "description": "نظام المعلم للخياطة المتكامل لإدارة العملاء والمقاسات والطلبات والحسابات والبضاعة",
  "lang": "ar",
  "dir": "rtl",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#edf3f3",
  "theme_color": "#287d78",
  "version": "5.11",
  "prefer_related_applications": false,
  "categories": [
    "business",
    "productivity"
  ],
  "screenshots": [
    {
      "src": "screenshot-mobile-v5.4.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "لوحة المعلم للخياطة على الهاتف"
    },
    {
      "src": "screenshot-desktop-v5.4.png",
      "sizes": "1440x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "لوحة المعلم للخياطة على الكمبيوتر"
    }
  ],
  "shortcuts": [
    {
      "name": "العملاء والمقاسات",
      "short_name": "العملاء",
      "url": "./index.html?v=5.11#customers",
      "icons": [
        {
          "src": "icon-192-v5.8.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "الطلبات",
      "short_name": "الطلبات",
      "url": "./index.html?v=5.11#orders",
      "icons": [
        {
          "src": "icon-192-v5.8.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "tab_strip": {
    "home_tab": {
      "icons": [{ "src": "icon-192-v5.8.png", "sizes": "192x192", "type": "image/png" }]
    },
    "new_tab_button": {
      "url": "./index.html?v=5.11#orders"
    }
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "scope_extensions": [
    {
      "type": "web",
      "origin": "https://minasar326-rgb.github.io"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html?v=5.11#backup",
      "accept": {
        "application/json": [
          ".json"
        ],
        "text/csv": [
          ".csv"
        ]
      },
      "icons": [
        {
          "src": "icon-192-v5.8.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+tailor",
      "url": "./index.html?v=5.11&action=%s"
    }
  ],
  "share_target": {
    "action": "./index.html?v=5.11",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "note_taking": {
    "new_note_url": "./index.html?v=5.11#orders?action=new"
  },
  "widgets": [
    {
      "name": "ملخص المعلم للخياطة",
      "description": "وصول سريع إلى العملاء والطلبات في المعلم للخياطة",
      "tag": "tailor-dashboard",
      "template": "tailor-dashboard-template",
      "ms_ac_template": "./widget-template.json",
      "data": "./widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "screenshot-desktop-v5.4.png",
          "sizes": "1440x900",
          "label": "ملخص المعلم للخياطة"
        }
      ],
      "icons": [
        {
          "src": "icon-192-v5.8.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "icons": [
    {
      "src": "icon-180-v5.8.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192-v5.8.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512-v5.8.png",
      "sizes": "512x512",
      "type": "image/png",
